# Copy to .env and fill in what you have. Everything is optional.

# Claude scores each video for depth, hype and freshness, and writes the takeaway.
# Without it, a simple keyword scorer is used instead.
ANTHROPIC_API_KEY=

# Model used for scoring (default: claude-opus-5-5).
# claude-haiku-5-5 is much cheaper if you score thousands of videos.
SHORTSIGNAL_MODEL=claude-opus-5-5

# YouTube Data API v3 key (Google Cloud console). Adds search-based discovery
# on top of the keyless channel RSS feeds. 10,000 free units/day; each search costs 100.
YOUTUBE_API_KEY=

PORT=5173
